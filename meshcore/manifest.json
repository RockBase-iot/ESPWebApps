    "nm-epd-420-bw-room-server": { "displayName": "NM-EPD-420-BW-Room-Server", "chip": "esp32s3", "fileSet": "esp32s3-four-app" }
  },
  "versions": [
    { "id": "v1.17.0", "devices": ["nm-epd-420-bw-companion-radio-ble", "nm-epd-420-bw-companion-radio-usb", "nm-epd-420-bw-kiss-modem", "nm-epd-420-bw-repeater", "nm-epd-420-bw-room-server"] }

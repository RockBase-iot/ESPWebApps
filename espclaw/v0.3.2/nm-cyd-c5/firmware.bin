  color-scheme: light dark;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

body {
  margin: 0;
  min-height: 100vh;
  display: grid;
  place-items: center;
  background: #f4f7f8;
  color: #172026;
}

main {
  width: min(420px, calc(100vw - 32px));
  padding: 28px;
  border: 1px solid #d7e0e4;
  border-radius: 8px;
  background: #ffffff;
  box-shadow: 0 12px 30px rgba(23, 32, 38, 0.08);
}

h1 {
  margin: 0 0 20px;
  font-size: 28px;
  line-height: 1.15;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.switch {
  position: relative;
  display: inline-block;
  width: 58px;
  height: 32px;
}

.switch input {
  opacity: 0;
  width: 0;
  height: 0;
}

.slider {
  position: absolute;
  inset: 0;
  cursor: pointer;
  background: #8a98a0;
  border-radius: 999px;
  transition: background 160ms ease;
}

.slider:before {
  content: "";
  position: absolute;
  width: 24px;
  height: 24px;
  left: 4px;
  top: 4px;
  border-radius: 50%;
  background: white;
  transition: transform 160ms ease;
}

input:checked + .slider {
  background: #1976d2;
}

input:checked + .slider:before {
  transform: translateX(26px);
}

#status {
  margin-top: 18px;
  min-height: 22px;
  color: #4d5b63;
  font-size: 14px;
